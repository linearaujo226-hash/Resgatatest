"use client";

import AppHeader from "@/components/AppHeader";
import { getSupabaseBrowserClient } from "@/lib/supabase";
import { useCallback, useEffect, useState } from "react";

type Mode = "habitos" | "controle";
type Habit = {
  id: string;
  name: string;
  category: string;
  goal_amount: number | string;
  usual_amount?: number | string;
  active: boolean;
};
type Entry = {
  id: string;
  habit_id: string;
  entry_date: string;
  status: string;
  amount_spent: number | string;
  amount_avoided?: number | string;
  notes: string | null;
};
type Expense = {
  id: string;
  name: string;
  category: string;
  amount: number | string;
  expense_date: string;
  notes: string | null;
  account_id: string | null;
  habit_entry_id?: string | null;
};
type Wallet = {
  id: string;
  name: string;
  balance: number | string;
};

const today = () => {
  const now = new Date();
  return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
};
const money = (value: number) =>
  value.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
const num = (value: number | string | null | undefined) => Number(value ?? 0);
const categories = [
  ["alimentacao", "Alimentação"],
  ["transporte", "Transporte"],
  ["casa", "Casa"],
  ["saude", "Saúde"],
  ["lazer", "Lazer"],
  ["compras", "Compras"],
  ["habitos", "Hábitos"],
  ["educacao", "Educação"],
  ["outros", "Outros"],
];

export default function HabitControlApp({ mode }: { mode: Mode }) {
  const supabase = getSupabaseBrowserClient();
  const isHabits = mode === "habitos";
  const [userId, setUserId] = useState("");
  const [habits, setHabits] = useState<Habit[]>([]);
  const [entries, setEntries] = useState<Entry[]>([]);
  const [expenses, setExpenses] = useState<Expense[]>([]);
  const [wallets, setWallets] = useState<Wallet[]>([]);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState("");
  const [period, setPeriod] = useState("30");

  const [habitName, setHabitName] = useState("");
  const [habitCategory, setHabitCategory] = useState("personalizado");
  const [habitGoal, setHabitGoal] = useState("0");
  const [habitUsualAmount, setHabitUsualAmount] = useState("0");
  const [selectedHabit, setSelectedHabit] = useState("");
  const [entryDate, setEntryDate] = useState(today());
  const [entryStatus, setEntryStatus] = useState("occurred");
  const [habitSpent, setHabitSpent] = useState("0");
  const [habitAvoided, setHabitAvoided] = useState("");
  const [habitAccount, setHabitAccount] = useState("");
  const [habitNotes, setHabitNotes] = useState("");

  const [expenseName, setExpenseName] = useState("");
  const [expenseCategory, setExpenseCategory] = useState("alimentacao");
  const [expenseAmount, setExpenseAmount] = useState("");
  const [expenseDate, setExpenseDate] = useState(today());
  const [expenseAccount, setExpenseAccount] = useState("");
  const [expenseNotes, setExpenseNotes] = useState("");

  const loadData = useCallback(async () => {
    setLoading(true);
    setMessage("");
    try {
      const { data: auth, error: authError } = await supabase.auth.getUser();
      if (authError) throw authError;
      if (!auth.user) {
        window.location.href = "/login";
        return;
      }
      setUserId(auth.user.id);

      const [habitResult, entryResult, expenseResult, walletResult] = await Promise.all([
        supabase.from("habit_controls")
          .select("id,name,category,goal_amount,usual_amount,active")
          .eq("user_id", auth.user.id)
          .eq("active", true)
          .order("created_at", { ascending: false }),
        supabase.from("habit_control_entries")
          .select("id,habit_id,entry_date,status,amount_spent,amount_avoided,notes")
          .eq("user_id", auth.user.id)
          .order("entry_date", { ascending: false })
          .limit(300),
        supabase.from("financial_expenses")
          .select("id,name,category,amount,expense_date,notes,account_id,habit_entry_id")
          .eq("user_id", auth.user.id)
          .order("expense_date", { ascending: false })
          .limit(500),
        supabase.from("wallet_accounts")
          .select("id,name,balance")
          .eq("user_id", auth.user.id)
          .order("created_at", { ascending: true }),
      ]);
      if (habitResult.error) throw habitResult.error;
      if (entryResult.error) throw entryResult.error;
      if (expenseResult.error) throw expenseResult.error;
      if (walletResult.error) throw walletResult.error;

      const loadedHabits = (habitResult.data ?? []) as Habit[];
      setHabits(loadedHabits);
      setEntries((entryResult.data ?? []) as Entry[]);
      setExpenses((expenseResult.data ?? []) as Expense[]);
      setWallets((walletResult.data ?? []) as Wallet[]);
      setSelectedHabit((current) =>
        current && loadedHabits.some((habit) => habit.id === current)
          ? current : loadedHabits[0]?.id ?? "",
      );
    } catch (error) {
      setMessage(error instanceof Error ? error.message : "Não foi possível carregar os dados.");
    } finally {
      setLoading(false);
    }
  }, [supabase]);

  useEffect(() => { void loadData(); }, [loadData]);

  const cutoff = new Date();
  cutoff.setDate(cutoff.getDate() - Number(period) + 1);
  const recentExpenses = expenses.filter((item) => {
    const date = new Date(`${item.expense_date}T12:00:00`);
    return date >= cutoff && item.expense_date <= today();
  });
  const periodTotal = recentExpenses.reduce((sum, item) => sum + num(item.amount), 0);
  const todayExpenses = expenses
    .filter((item) => item.expense_date === today())
    .reduce((sum, item) => sum + num(item.amount), 0);
  // Total acumulado: considera todos os gastos registrados nos hábitos.
  // Só muda quando um registro é adicionado, editado ou excluído.
  const habitSpend = entries.reduce(
    (sum, item) => sum + num(item.amount_spent),
    0
  );
  const selectedHabitEntries = entries.filter((item) => item.habit_id === selectedHabit);
  const recordedDays = selectedHabitEntries.length;
  const occurredDays = selectedHabitEntries.filter((item) => item.status === "occurred").length;
  const selectedHabitData = habits.find((habit) => habit.id === selectedHabit);
  const periodStart = cutoff.toISOString().slice(0, 10);
  const estimatedSavings = entries
    .filter((item) =>
      item.entry_date >= periodStart &&
      item.entry_date <= today() &&
      item.status === "not_occurred"
    )
    .reduce((sum, item) => {
      return sum + Math.max(0, num(item.amount_avoided));
    }, 0);

  async function addHabit(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setSaving(true);
    setMessage("");
    try {
      const goal = Number(habitGoal.replace(",", "."));
      const usual = Number(habitUsualAmount.replace(",", "."));
      if (!habitName.trim()) throw new Error("Informe o nome do hábito.");
      if (!Number.isFinite(goal) || goal < 0) throw new Error("Informe uma meta válida.");
      if (!Number.isFinite(usual) || usual < 0) throw new Error("Informe um valor habitual válido.");
      const { data, error } = await supabase.from("habit_controls").insert({
        user_id: userId,
        name: habitName.trim(),
        category: habitCategory,
        goal_amount: goal,
        usual_amount: usual,
      }).select("id").single();
      if (error) throw error;
      setHabitName("");
      setHabitGoal("0");
      setHabitUsualAmount("0");
      setSelectedHabit(data.id);
      setMessage("Hábito criado.");
      await loadData();
    } catch (error) {
      setMessage(error instanceof Error ? error.message : "Não foi possível criar o hábito.");
    } finally { setSaving(false); }
  }

  async function saveHabitEntry(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setSaving(true);
    setMessage("");
    try {
      if (!selectedHabit) throw new Error("Cadastre ou selecione um hábito.");

      const amount = Number(habitSpent.replace(",", "."));
      const avoided = Number(habitAvoided.replace(",", ".") || "0");

      if (!Number.isFinite(amount) || amount < 0) {
        throw new Error("Informe um gasto real válido.");
      }
      if (!Number.isFinite(avoided) || avoided < 0) {
        throw new Error("Informe um valor evitado válido.");
      }
      if (entryStatus !== "occurred" && amount > 0) {
        throw new Error("Só informe gasto real quando o comportamento aconteceu.");
      }
      if (entryStatus !== "not_occurred" && avoided > 0) {
        throw new Error("O valor que teria gasto só pode ser informado quando o comportamento não aconteceu.");
      }
      if (amount > 0 && !habitAccount) {
        throw new Error("Selecione a conta da Carteira usada para esse gasto real.");
      }
      if (amount > 0 && !wallets.some((wallet) => wallet.id === habitAccount)) {
        throw new Error("A conta selecionada não foi encontrada. Atualize a página e tente novamente.");
      }

      // O RPC registra o gasto real e ajusta a Carteira uma única vez.
      // O valor evitado é apenas informativo: não altera contas ou despesas.
      const { error } = await supabase.rpc("save_habit_entry", {
        p_habit_id: selectedHabit,
        p_entry_date: entryDate,
        p_status: entryStatus,
        p_amount_spent: amount,
        p_notes: habitNotes.trim() || null,
        p_account_id: entryStatus === "occurred" && amount > 0
          ? habitAccount
          : null,
        p_amount_avoided: avoided,
      });
      if (error) throw error;

      setHabitNotes("");
      setHabitSpent("0");
      setHabitAvoided("");
      setHabitAccount("");
      setMessage(
        amount > 0
          ? "Registro salvo e gasto real lançado na conta selecionada."
          : avoided > 0
            ? "Registro salvo. O valor evitado foi contabilizado apenas na economia estimada."
            : "Registro do hábito salvo."
      );
      await loadData();
    } catch (error) {
      setMessage(error instanceof Error ? error.message : "Não foi possível salvar o registro.");
    } finally {
      setSaving(false);
    }
  }

  async function addExpense(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setSaving(true);
    setMessage("");
    try {
      const amount = Number(expenseAmount.replace(",", "."));
      if (!expenseName.trim()) throw new Error("Informe a descrição da despesa.");
      if (!Number.isFinite(amount) || amount <= 0) throw new Error("Informe um valor maior que zero.");
      if (!expenseAccount) throw new Error("Selecione a conta de onde saiu o dinheiro.");
      const { error } = await supabase.rpc("register_general_expense", {
        p_name: expenseName.trim(),
        p_category: expenseCategory,
        p_amount: amount,
        p_expense_date: expenseDate,
        p_account_id: expenseAccount,
        p_notes: expenseNotes.trim() || null,
      });
      if (error) throw error;
      setExpenseName("");
      setExpenseAmount("");
      setExpenseNotes("");
      setMessage("Despesa registrada e saldo da Carteira atualizado.");
      await loadData();
    } catch (error) {
      setMessage(error instanceof Error ? error.message : "Não foi possível registrar a despesa.");
    } finally { setSaving(false); }
  }

  async function changeExpenseAccount(expense: Expense, accountId: string) {
    if (accountId === (expense.account_id ?? "")) return;
    setSaving(true);
    setMessage("");
    try {
      const { error } = await supabase.rpc("assign_financial_expense_account", {
        p_expense_id: expense.id,
        p_account_id: accountId || null,
      });
      if (error) throw error;
      setMessage("Conta da despesa atualizada e saldos recalculados.");
      await loadData();
    } catch (error) {
      setMessage(error instanceof Error ? error.message : "Não foi possível alterar a conta.");
    } finally {
      setSaving(false);
    }
  }

  async function editExpense(expense: Expense) {
    const name = window.prompt("Descrição da despesa:", expense.name);
    if (name === null) return;
    if (!name.trim()) {
      setMessage("A descrição não pode ficar vazia.");
      return;
    }

    const categoryOptions = categories.map(([key, label]) => `${key} = ${label}`).join("\n");
    const category = window.prompt(
      `Categoria (digite a chave):\n${categoryOptions}`,
      expense.category
    );
    if (category === null) return;
    if (!categories.some(([key]) => key === category.trim())) {
      setMessage("Categoria inválida. Use uma das chaves apresentadas.");
      return;
    }

    const amountText = window.prompt(
      "Valor da despesa (ex.: 25,90):",
      String(num(expense.amount)).replace(".", ",")
    );
    if (amountText === null) return;
    const amount = Number(amountText.trim().replace(",", "."));
    if (!Number.isFinite(amount) || amount <= 0) {
      setMessage("Informe um valor maior que zero.");
      return;
    }

    const notes = window.prompt("Observações (deixe em branco para remover):", expense.notes ?? "");
    if (notes === null) return;

    if (!window.confirm("Salvar as alterações desta despesa e ajustar a Carteira, se necessário?")) return;

    setSaving(true);
    setMessage("");
    try {
      const { error } = await supabase.rpc("update_financial_expense", {
        p_expense_id: expense.id,
        p_name: name.trim(),
        p_category: category.trim(),
        p_amount: amount,
        p_notes: notes.trim() || null,
      });
      if (error) throw error;
      setMessage("Despesa atualizada. O saldo foi ajustado pela diferença do valor.");
      await loadData();
    } catch (error) {
      setMessage(error instanceof Error ? error.message : "Não foi possível editar a despesa.");
    } finally {
      setSaving(false);
    }
  }

  async function deleteExpense(expense: Expense) {
    if (!window.confirm(
      `Excluir a despesa "${expense.name}" de ${money(num(expense.amount))}?\n\nSe o valor foi descontado de uma conta, ele será devolvido. Esta ação não pode ser desfeita.`
    )) return;

    setSaving(true);
    setMessage("");
    try {
      const { error } = await supabase.rpc("delete_financial_expense", {
        p_expense_id: expense.id,
      });
      if (error) throw error;
      setMessage("Despesa excluída e saldo da Carteira ajustado, quando aplicável.");
      await loadData();
    } catch (error) {
      setMessage(error instanceof Error ? error.message : "Não foi possível excluir a despesa.");
    } finally {
      setSaving(false);
    }
  }

  async function deactivateHabit(habit: Habit) {
    if (!window.confirm(`Desativar o hábito "${habit.name}"? O histórico será preservado.`)) return;
    setSaving(true);
    try {
      const { error } = await supabase.from("habit_controls")
        .update({ active: false })
        .eq("id", habit.id)
        .eq("user_id", userId);
      if (error) throw error;
      setMessage("Hábito desativado. O histórico foi preservado.");
      await loadData();
    } catch (error) {
      setMessage(error instanceof Error ? error.message : "Não foi possível desativar o hábito.");
    } finally { setSaving(false); }
  }

  return (
    <main className="hc-page">
      <AppHeader />
      <div className="hc-wrap">
        {isHabits ? (
          <>
            <section className="hc-habits-top" aria-label="Apresentação e resumo financeiro">
              <header className="hc-hero hc-habits-hero">
                <div>
                  <span className="hc-eyebrow">BEM-ESTAR FINANCEIRO</span>
                  <h1>Hábitos</h1>
                  <p className="hc-habits-motivation">
                    Pequenas escolhas de hoje constroem uma vida financeira mais leve amanhã.
                  </p>
                </div>
              </header>
              <section className="hc-stats hc-habits-summary" aria-label="Resumo financeiro dos hábitos">
              <article className="hc-stat">
                <span>Total gasto</span>
                <strong>{money(habitSpend)}</strong>
                <small>Gastos reais registrados nos hábitos</small>
              </article>
              <article className="hc-stat">
                <span>Economizado por não gastar</span>
                <strong>{money(estimatedSavings)}</strong>
                <small>Estimativa de gastos evitados. Não altera o saldo da Carteira.</small>
              </article>
              </section>
            </section>
          </>
        ) : (
          <header className="hc-hero">
            <div>
              <span className="hc-eyebrow">ORGANIZAÇÃO DO DINHEIRO</span>
              <h1>Controle financeiro</h1>
              <p>Registre despesas do dia a dia, acompanhe categorias e entenda para onde seu dinheiro está indo.</p>
            </div>
            <div className="hc-hero-mark" aria-hidden="true">↗</div>
          </header>
        )}


        {message && <div className="hc-message" role="status">{message}</div>}
        {loading ? <section className="hc-card">Carregando seus dados…</section> : <>
          <section className="hc-stats">
            <article className="hc-stat hc-stat-expenses"><span>Despesas financeiras</span><strong>{money(periodTotal)}</strong><small>Total dos lançamentos financeiros no período selecionado</small></article>
            <article className="hc-stat hc-stat-today"><span>Gastos de hoje</span><strong>{money(todayExpenses)}</strong><small>Total das despesas lançadas com a data de hoje</small></article>
            <article className="hc-stat hc-stat-wallet"><span>Saldo total na Carteira</span><strong>{money(wallets.reduce((s, w) => s + num(w.balance), 0))}</strong><small>Soma dos saldos atuais das contas cadastradas</small></article>
            <article className="hc-stat hc-stat-habits"><span>{isHabits ? "Gastos registrados em hábitos" : "Lançamentos no período"}</span><strong>{isHabits ? money(habitSpend) : recentExpenses.length}</strong><small>{isHabits ? "Valores informados nos registros de hábitos" : "Quantidade de despesas no período selecionado"}</small></article>
          </section>

          <section className="hc-card hc-period">
            <label htmlFor="hc-period">Período de análise</label>
            <select id="hc-period" value={period} onChange={(e) => setPeriod(e.target.value)}>
              <option value="7">Últimos 7 dias</option>
              <option value="30">Últimos 30 dias</option>
              <option value="90">Últimos 90 dias</option>
              <option value="365">Últimos 12 meses</option>
            </select>
          </section>

          {isHabits ? <>
            <div className="hc-columns">
              <section className="hc-card hc-habit-create-card">
                <h2>Criar um hábito</h2>
                <p className="hc-muted">Escolha apenas o que faz sentido para você. As sugestões não serão cadastradas até você confirmar.</p>

                <div className="hc-habit-builder">

                <details className="hc-habit-picker">
                  <summary>Selecionar um hábito <span>Escolha uma sugestão para preencher o formulário</span></summary>
                  <div className="hc-habit-suggestions">
                  <strong>Sugestões para começar</strong>
                  <p className="hc-muted">Selecione uma opção para preencher o formulário ou crie seu próprio hábito.</p>
                  <div className="hc-habit-grid">
                    {[
                      { name: "Cafés, lanches e pequenas refeições", category: "alimentacao", icon: "☕", tone: "food" },
                      { name: "Delivery e refeições fora de casa", category: "alimentacao", icon: "🍽️", tone: "food" },
                      { name: "Pequenas despesas do dia a dia", category: "compras", icon: "🧾", tone: "daily" },
                      { name: "Compras não planejadas", category: "compras", icon: "🛍️", tone: "shopping" },
                      { name: "Roupas, calçados e acessórios", category: "compras", icon: "👟", tone: "shopping" },
                      { name: "Compras parceladas", category: "compras", icon: "💳", tone: "shopping" },
                      { name: "Assinaturas e serviços recorrentes", category: "lazer", icon: "🔄", tone: "digital" },
                      { name: "Jogos e compras digitais", category: "lazer", icon: "🎮", tone: "digital" },
                      { name: "Apostas e jogos de azar", category: "lazer", icon: "🎯", tone: "risk" },
                      { name: "Passeios e atividades de lazer", category: "lazer", icon: "🌿", tone: "leisure" },
                      { name: "Transporte por aplicativo", category: "transporte", icon: "🚗", tone: "transport" },
                      { name: "Combustível e deslocamentos", category: "transporte", icon: "⛽", tone: "transport" },
                      { name: "Gastos com tabaco", category: "outros", icon: "🚭", tone: "wellbeing" },
                      { name: "Gastos com bebidas alcoólicas", category: "outros", icon: "🥤", tone: "wellbeing" },
                      { name: "Tempo de tela e gastos digitais", category: "outros", icon: "📱", tone: "digital" },
                      { name: "Outro hábito ou comportamento pessoal", category: "personalizado", icon: "✨", tone: "personal" },
                    ].map((suggestion) => (
                      <button
                        key={suggestion.name}
                        type="button"
                        className={`hc-habit-suggestion hc-tone-${suggestion.tone}${habitName === suggestion.name ? " is-selected" : ""}`}
                        onClick={(event) => {
                          setHabitName(suggestion.name);
                          setHabitCategory(suggestion.category);
                          event.currentTarget.closest("details")?.removeAttribute("open");
                        }}
                      >
                        <span className="hc-habit-suggestion-icon" aria-hidden="true">{suggestion.icon}</span><span className="hc-habit-suggestion-label">{suggestion.name}</span><span className="hc-habit-suggestion-arrow" aria-hidden="true">↗</span>
                      </button>
                    ))}
                  </div>
                  </div>
                </details>

                <details className="hc-habit-create-details">
                  <summary>
                    <span>Cadastrar hábito</span>
                    <span className="hc-habit-create-hint">Clique para abrir ou fechar</span>
                  </summary>
                  <form className="hc-form" onSubmit={addHabit}>
                  <label>Hábitos
                    <input value={habitName} onChange={(e) => setHabitName(e.target.value)} maxLength={80} placeholder="Escolha uma sugestão ou digite seu hábito" required />
                  </label>
                  <label>Categoria
                    <select value={habitCategory} onChange={(e) => setHabitCategory(e.target.value)}>
                      <option value="personalizado">Personalizado</option>
                      <option value="alimentacao">Alimentação</option>
                      <option value="compras">Compras</option>
                      <option value="lazer">Lazer</option>
                      <option value="transporte">Transporte</option>
                      <option value="outros">Outro</option>
                    </select>
                  </label>
                  <label>Limite de gastos (R$) — opcional
                    <input value={habitGoal} onChange={(e) => setHabitGoal(e.target.value)} inputMode="decimal" placeholder="Ex.: 150,00" />
                  </label>
                  <label>Valor habitual por ocorrência (R$) — opcional
                    <input value={habitUsualAmount} onChange={(e) => setHabitUsualAmount(e.target.value)} inputMode="decimal" placeholder="Ex.: 15,00" />
                  </label>
                  <p className="hc-muted">Usado somente para estimar a economia nos dias em que o hábito não aconteceu. Não altera o saldo da Carteira.</p>
                  <p className="hc-muted">A meta é opcional. Você pode acompanhar um hábito sem definir um limite de gastos.</p>
                  <button disabled={saving}>{saving ? "Salvando…" : "Adicionar hábito"}</button>
                  </form>
                </details>
                </div>
              </section>

            </div>

            <div className="hc-columns hc-habit-tracking-columns">
              <section className="hc-card hc-record-card">
                <h2>Registrar acompanhamento</h2>
                <p className="hc-muted">Registre seu dia e acompanhe seus hábitos com tranquilidade.</p>
                <form className="hc-form" onSubmit={saveHabitEntry}>
                  <label className="hc-record-habit">Hábito
                    <select value={selectedHabit} onChange={(e) => setSelectedHabit(e.target.value)} required>
