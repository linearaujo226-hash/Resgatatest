        .hc-eyebrow{font-size:11px;letter-spacing:1.4px;font-weight:800;color:#08765e}
        h1{font-size:clamp(30px,5vw,44px);letter-spacing:-1.4px;line-height:1.12;margin:10px 0}
        .hc-hero p{max-width:680px;color:#53647a;margin:0}
