.home-hero {
  border-right: 1px solid #cbd8e7;
  border-left: 1px solid #cbd8e7;
  background:
    radial-gradient(ellipse at 90% 15%, rgba(33, 167, 133, .25), transparent 36%),
    radial-gradient(ellipse at 5% 95%, rgba(60, 117, 185, .22), transparent 40%),
    linear-gradient(130deg, #102b45 0%, #173d55 55%, #174c56 100%);
}

.home-hero .home-eyebrow {
  color: #baf1db;
  border-color: rgba(146, 224, 192, .28);
  background: rgba(255, 255, 255, .08);
}

.home-hero h1,
.home-hero .home-copy h1 {
  color: #ffffff;
}

.home-hero h1 span {
  background: linear-gradient(100deg, #79e0b6, #b3ebd3);
  background-clip: text;
  -webkit-background-clip: text;
