/* =========================================================
   RESGATA+ — PADRÃO RESPONSIVO GLOBAL
   Celular, tablet, notebook e monitor
   ========================================================= */

html {
  width: 100%;
  min-width: 0;
  overflow-x: clip;
  -webkit-text-size-adjust: 100%;
}

body {
  width: 100%;
  min-width: 0;
  margin: 0;
  border-left: 0 !important;
  border-right: 0 !important;
  overflow-wrap: break-word;
}

body::before,
body::after {
  display: none !important;
}

main,
section,
header,
footer,
nav,
article,
aside,
form,
fieldset {
  min-width: 0;
  max-width: 100%;
}

img,
video,
canvas,
iframe,
svg {
  max-width: 100%;
}

input,
select,
textarea,
button {
  min-width: 0;
  max-width: 100%;
}

input,
select,
textarea {
  box-sizing: border-box;
}

button,
.btn,
.app-header-link,
.app-header-logout {
  touch-action: manipulation;
}

:focus-visible {
  outline-offset: 3px;
}

.container {
  width: min(100% - 32px, 1240px);
  margin-inline: auto;
}

.page {
  width: min(100% - 32px, 1240px);
  margin-inline: auto;
  padding-top: clamp(20px, 3vw, 38px);
  padding-bottom: clamp(36px, 5vw, 72px);
}

.grid,
.stats-grid,
.debts-summary-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.tablewrap,
[style*="overflowX: auto"],
[style*="overflow-x: auto"] {
  max-width: 100%;
  overflow-x: auto;
  overscroll-behavior-inline: contain;
  -webkit-overflow-scrolling: touch;
}

table {
  max-width: 100%;
}

th,
td {
  overflow-wrap: anywhere;
}

.app-header {
  min-width: 0;
  max-width: 100%;
}

.app-header-brand,
.app-header-nav {
  min-width: 0;
}

.field,
.form,
.panel,
.feature,
.stat-card,
.auth-card {
  min-width: 0;
  max-width: 100%;
}

@media (min-width: 1400px) {
  .container,
  .page {
    width: min(100% - 64px, 1320px);
  }
}

@media (max-width: 1100px) {
  .grid,
  .stats-grid,
  .debts-summary-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hero-grid {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 28px;
  }

  .section {
    padding-block: 52px;
  }
}

@media (max-width: 850px) {
  .container,
  .page {
    width: calc(100% - 28px);
  }

  .hero-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .app-header {
    width: 100%;
  }

  .debts-summary-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .page h1 {
    font-size: clamp(1.55rem, 5vw, 2rem);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
}

@media (max-width: 600px) {
  body {
    font-size: 15px;
    line-height: 1.55;
  }

  .container,
  .page {
    width: calc(100% - 24px);
  }

  .page {
    padding-top: 18px;
    padding-bottom: 36px;
  }

  .grid,
  .stats-grid,
  .debts-summary-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }

  .section {
    padding-block: 38px;
  }

  .section-heading {
    margin-bottom: 24px;
    text-align: left;
  }

  .hero h1 {
    font-size: clamp(2rem, 9vw, 3rem);
    letter-spacing: -1px;
    overflow-wrap: anywhere;
  }

  .actions {
    align-items: stretch;
  }

  .actions .btn,
  .btn-block {
    width: 100%;
  }

  .panel,
  .feature,
  .stat-card,
  .auth-card {
    padding: 18px;
  }

  .app-header {
    gap: 12px;
    padding: 12px;
  }

  .app-header-nav.is-open {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .debts-summary-card {
    min-height: 0;
    padding: 17px;
  }

  .debts-summary-value {
    font-size: clamp(1.4rem, 7vw, 1.75rem);
    overflow-wrap: anywhere;
  }

  th,
  td {
    padding: 8px 7px;
  }

  input,
  select,
  textarea {
    font-size: 16px;
  }
}

@media (max-width: 380px) {
  .container,
  .page {
    width: calc(100% - 20px);
  }

  .panel,
  .feature,
  .stat-card,
  .auth-card {
    padding: 14px;
  }

  .app-header-nav.is-open {
    grid-template-columns: minmax(0, 1fr);
  }

  .debts-summary-card {
    padding: 14px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}

/* ===== RESGATA+ — REFINAMENTO RESPONSIVO ===== */

/* Evita valores CSS inválidos no cabeçalho da página inicial */
.home-nav {
  margin-left: 0;
  margin-right: 0;
}

.home-nav > * {
  min-width: 0;
}

/* Impede que o conteúdo force a página para fora da tela */
.container,
.page,
.app-header,
.debts-hero,
.debts-summary,
.debts-summary-card {
  box-sizing: border-box;
  min-width: 0;
}

.home-nav,
.home-nav nav,
.home-nav .navlinks,
.app-header-nav {
  max-width: 100%;
}

/* Tabela: texto legível e rolagem horizontal apenas no quadro */
#lista-dividas {
  width: 100%;
  max-width: 100%;
  overflow-x: auto;
  overscroll-behavior-x: contain;
  -webkit-overflow-scrolling: touch;
}

#lista-dividas table {
  font-size: 13px !important;
  line-height: 1.5;
}

#lista-dividas th,
#lista-dividas td {
  padding: 10px 12px;
  vertical-align: middle;
  overflow-wrap: anywhere;
}

#lista-dividas th {
  white-space: normal;
}

#lista-dividas td button,
#lista-dividas td a {
  max-width: 100%;
  white-space: normal;
}

/* Notebook e telas médias */
@media (min-width: 601px) and (max-width: 1100px) {
  .container,
  .page {
    width: calc(100% - 32px);
  }

  .debts-summary-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
}

/* Celulares */
@media (max-width: 600px) {
  .container,
  .page {
    width: calc(100% - 24px);
  }

  .debts-summary {
    margin-bottom: 24px;
  }

  .debts-summary-heading {
    margin-bottom: 14px;
  }

  .debts-summary-card {
    padding: 16px;
    border-radius: 15px;
  }

  #lista-dividas th,
  #lista-dividas td {
    padding: 9px 10px;
  }

  button,
  input,
  select,
  textarea {
    font-size: 16px;
  }
}

/* Celulares estreitos */
@media (max-width: 380px) {
  .container,
  .page {
    width: calc(100% - 20px);
  }

  .debts-summary-card {
    padding: 14px;
  }

  #lista-dividas th,
  #lista-dividas td {
    padding: 8px;
  }
}

/* RESGATA: layout aprimorado para criação de hábitos */
.hc-habit-create-card {
  grid-column: 1 / -1;
  min-width: 0;
}

.hc-habit-builder {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
  gap: 24px;
  align-items: start;
  margin-top: 22px;
}

.hc-habit-suggestions {
  min-width: 0;
  padding: 20px;
  border: 1px solid var(--border, #e2e8f0);
  border-radius: 16px;
  background: var(--card-muted, #f8fafc);
}

.hc-habit-suggestions > strong {
  display: block;
  margin-bottom: 6px;
  font-size: 1rem;
}

.hc-habit-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin-top: 16px;
}

.hc-habit-suggestion {
  display: flex;
  align-items: center;
  gap: 9px;
  min-width: 0;
  min-height: 48px;
  padding: 11px 12px;
  border: 1px solid var(--border, #dbe3ed);
  border-radius: 12px;
  background: var(--card, #fff);
  color: var(--foreground, #1e293b);
  font: inherit;
  font-size: 0.9rem;
  line-height: 1.35;
  text-align: left;
  cursor: pointer;
  transition: border-color 160ms ease, background-color 160ms ease,
    box-shadow 160ms ease, transform 160ms ease;
}

.hc-habit-suggestion > span {
  flex: 0 0 auto;
  font-size: 1.15rem;
  font-weight: 700;
}

.hc-habit-suggestion:hover {
  border-color: var(--primary, #64748b);
  transform: translateY(-1px);
}

.hc-habit-suggestion.is-selected {
  border-color: var(--primary, #475569);
  background: var(--selected-bg, #eef2ff);
  box-shadow: 0 0 0 2px var(--selected-ring, #c7d2fe);
}

.hc-habit-builder > .hc-form {
  min-width: 0;
  padding: 20px;
  border: 1px solid var(--border, #e2e8f0);
  border-radius: 16px;
  background: var(--card, #fff);
}

.hc-habit-builder > .hc-form > label {
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin-bottom: 16px;
  font-weight: 600;
}

.hc-habit-builder > .hc-form input,
.hc-habit-builder > .hc-form select {
  box-sizing: border-box;
  width: 100%;
  min-height: 44px;
  padding: 10px 12px;
  border: 1px solid var(--border, #cbd5e1);
  border-radius: 10px;
  background: var(--input-bg, #fff);
  color: inherit;
  font: inherit;
}

.hc-habit-builder > .hc-form input:focus,
.hc-habit-builder > .hc-form select:focus {
  outline: 2px solid var(--focus, #94a3b8);
  outline-offset: 2px;
}

.hc-habit-builder > .hc-form > button {
  width: 100%;
  min-height: 46px;
  margin-top: 8px;
}

@media (max-width: 900px) {
  .hc-habit-builder {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (max-width: 560px) {
  .hc-habit-suggestions,
  .hc-habit-builder > .hc-form {
    padding: 14px;
  }

  .hc-habit-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
  }

  .hc-habit-suggestion {
    min-height: 44px;
  }
}
