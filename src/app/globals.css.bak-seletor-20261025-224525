/* Laterais lisas no padrão visual do Resgata+ */
body::before,
body::after {
  content: "";
  position: fixed;
  top: 0;
  bottom: 0;
  width: 5px;
  z-index: 9999;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    #087f8c 0%,
    #0b746b 48%,
    #075e68 100%
  );
  opacity: 0.72;
}

body::before {
  left: 0;
}

body::after {
  right: 0;
}

/* Cabeçalho ocupando toda a largura da página */
.home-nav {
  display: flex;
  width: 100%;
  max-width: none;
  box-sizing: border-box;
  margin-left: 10;
  margin-right: 10;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 5px;
}

/* Evita que o conteúdo do cabeçalho fique estreito */
.home-nav > * {
  min-width: 10;
}

/* Se houver um container interno no cabeçalho */
.home-nav .container,
.home-nav .home-container,
.home-nav .nav-inner,
.home-nav .nav-container {
  width: 100%;
  max-width: none;
  box-sizing: border-box;
}

/* Mantém os links alinhados e organizados */
.home-nav nav {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 12px;
}

/* Em telas menores, permite que o cabeçalho se adapte */
@media (max-width: 760px) {
  .home-nav {
    justify-content: space-between;
    gap: 10px;
    padding-left: 10px;
    padding-right: 10px;
  }

  .home-nav nav {
    justify-content: flex-start;
    max-width: 100%;
  }
}

/* ===== CABEÇALHO PADRÃO DAS TELAS AUTENTICADAS ===== */
.app-header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px 22px;
  width: 100%;
  padding: 14px 16px;
  margin: 0 0 26px;
  border: 1px solid #e1eaf0;
  border-radius: 20px;
  background: rgba(255, 255, 255, .96);
  box-shadow: 0 8px 28px rgba(23, 50, 75, .06);
}

.app-header-brand {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  gap: 10px;
  color: #17324b;
  font-size: 19px;
  font-weight: 800;
  letter-spacing: -.4px;
  text-decoration: none;
}

.app-header-mark {
  display: grid;
  width: 43px;
  height: 43px;
  place-items: center;
  border-radius: 14px;
  background: linear-gradient(145deg, #13a889, #08745d);
  box-shadow: 0 5px 12px rgba(8, 127, 104, .2);
  color: #fff;
  font-size: 15px;
}

.app-header-brand-light {
  color: #087f68;
}

.app-header-nav {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 5px;
}

.app-header-link,
.app-header-logout {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  padding: 10px 12px;
  border: 1px solid transparent;
  border-radius: 11px;
  font: inherit;
  font-size: 12.5px;
  font-weight: 650;
  text-decoration: none;
  white-space: nowrap;
  transition: background-color .16s ease, color .16s ease, border-color .16s ease;
}

.app-header-link {
  color: #52677b;
}

.app-header-link:hover,
.app-header-link.active {
  border-color: #d1eee3;
  background: #e7f7f0;
  color: #08745d;
}

.app-header-link.active {
  font-weight: 750;
}

.app-header-logout {
  margin-left: 5px;
  border-color: #f0dada;
  background: #fffafa;
  color: #a64040;
  cursor: pointer;
}

.app-header-logout:hover:not(:disabled) {
  border-color: #e8bebe;
  background: #fff0f0;
}

.app-header-logout:disabled {
  cursor: wait;
  opacity: .65;
}

.app-header-link:focus-visible,
.app-header-logout:focus-visible,
.app-header-brand:focus-visible {
  outline: 3px solid rgba(19, 168, 137, .35);
  outline-offset: 3px;
}

.app-header-error {
  flex-basis: 100%;
  margin: 0;
  color: #a64040;
  font-size: 13px;
}

@media (max-width: 1150px) {
  .app-header {
