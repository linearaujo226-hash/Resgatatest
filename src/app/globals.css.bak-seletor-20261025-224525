/* ===== NOVA IDENTIDADE FINANCEIRA ===== */

:root {
  --bg: #edf2f8;
  --surface: #ffffff;
  --text: #142b45;
  --muted: #63758b;
  --primary: #087f68;
  --primary-dark: #075b4d;
  --border: #d5e0ec;
  --success: #087f55;
  --radius: 18px;
}

body {
  background: #eaf0f7;
  color: #142b45;
}

/* Navegação com contorno e fundo financeiro */
.home-nav {
  position: relative;
  border-right: 1px solid #d4dfeb;
  border-left: 1px solid #d4dfeb;
  border-bottom: 1px solid #d4dfeb;
  background: #f9fbfe;
  box-shadow: 0 4px 16px rgba(22, 48, 78, .045);
}

.brand-mark {
  background: linear-gradient(145deg, #0b8d72, #075847);
  box-shadow: 0 5px 12px rgba(8, 127, 104, .22);
}

